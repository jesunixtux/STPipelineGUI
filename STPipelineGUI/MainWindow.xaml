<Window x:Class="STPipelineGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="STPipelineGUI" Height="720" Width="1120"
        MinHeight="620" MinWidth="960"
        Background="#F4F6F8">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="180" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="STPipelineGUI" FontSize="26" FontWeight="SemiBold" Foreground="#17202A" />
                <TextBlock x:Name="RootPathText" Foreground="#53616F" Margin="0,4,0,0" />
            </StackPanel>
            <Button DockPanel.Dock="Right" Content="Recargar" Width="110" Height="34" Click="ReloadButton_Click" />
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="#D9E1E8" BorderThickness="1" CornerRadius="6">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Proyectos" FontSize="16" FontWeight="SemiBold" Margin="14,12,14,8" />
                    <ListBox x:Name="ProjectsList" Margin="8,0,8,8" DisplayMemberPath="Name" SelectionChanged="ProjectsList_SelectionChanged" />
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Background="White" BorderBrush="#D9E1E8" BorderThickness="1" CornerRadius="6" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock x:Name="ProjectNameText" Text="Selecciona un proyecto" FontSize="24" FontWeight="SemiBold" Foreground="#17202A" />
                        <TextBlock x:Name="ProjectDescriptionText" Foreground="#53616F" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <UniformGrid Grid.Row="1" Columns="4" Margin="0,18,0,18">
                        <StackPanel>
                            <TextBlock Text="AppID" Foreground="#53616F" />
                            <TextBlock x:Name="AppIdText" FontSize="16" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Branch" Foreground="#53616F" />
                            <TextBlock x:Name="BranchText" FontSize="16" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Content root" Foreground="#53616F" />
                            <TextBlock x:Name="ContentRootText" FontSize="14" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="VDF output" Foreground="#53616F" />
                            <TextBlock x:Name="BuildOutputText" FontSize="14" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </UniformGrid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <GroupBox Header="Plataformas" Padding="12" Margin="0,0,12,0">
                            <StackPanel>
                                <CheckBox x:Name="WindowsCheckBox" Content="Windows" Margin="0,0,0,10" Checked="PlatformCheckBox_Changed" Unchecked="PlatformCheckBox_Changed" />
                                <CheckBox x:Name="LinuxCheckBox" Content="Linux" Margin="0,0,0,10" Checked="PlatformCheckBox_Changed" Unchecked="PlatformCheckBox_Changed" />
                                <CheckBox x:Name="MacosCheckBox" Content="macOS" Checked="PlatformCheckBox_Changed" Unchecked="PlatformCheckBox_Changed" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Grid.Column="1" Header="Depots" Padding="12">
                            <DataGrid x:Name="DepotsGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="DepotID" Binding="{Binding DepotId}" Width="110" />
                                    <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="160" />
                                    <DataGridTextColumn Header="Plataforma" Binding="{Binding Platform}" Width="120" />
                                    <DataGridTextColumn Header="Ruta" Binding="{Binding ContentRoot}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                    </Grid>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button Content="Crear carpetas" Width="130" Height="36" Margin="0,0,10,0" Click="CreateFoldersButton_Click" />
                        <Button Content="Generar VDF" Width="120" Height="36" Margin="0,0,10,0" Click="GenerateVdfButton_Click" />
                        <Button Content="Probar SteamCMD" Width="140" Height="36" Click="RunSteamCmdButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#111820" BorderBrush="#25313D" BorderThickness="1" CornerRadius="6" Margin="0,12,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Logs" Foreground="#EAF0F6" FontWeight="SemiBold" Margin="12,10,12,0" />
                <TextBox x:Name="LogsTextBox" Margin="12,8,12,12" Background="#111820" BorderThickness="0" Foreground="#D6E1EA" FontFamily="Consolas" FontSize="13" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" />
            </DockPanel>
        </Border>
    </Grid>
</Window>

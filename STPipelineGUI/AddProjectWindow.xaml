<Window x:Class="STPipelineGUI.AddProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agregar proyecto" Height="650" Width="680"
        MinHeight="600" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0B1118">
    <Window.Resources>
        <SolidColorBrush x:Key="TextPrimary" Color="#E7EEF8" />
        <SolidColorBrush x:Key="TextMuted" Color="#9FB0C4" />
        <SolidColorBrush x:Key="CardBackground" Color="#121D28" />
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#243447" />
        <SolidColorBrush x:Key="AccentBlue" Color="#1E9BFF" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0B141E" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="#33475D" />
            <Setter Property="Padding" Value="10,7" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Margin" Value="0,0,18,0" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="#172637" />
            <Setter Property="BorderBrush" Value="#33475D" />
            <Setter Property="Padding" Value="16,9" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Nuevo proyecto Steam" FontSize="24" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Text="Configura los datos básicos. Podrás ajustar rutas, ramas y plataformas después." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,8,0,18" />

        <TextBlock Grid.Row="2" Text="Nombre del proyecto" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6" />
        <TextBox x:Name="ProjectNameTextBox" Grid.Row="3" />

        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="AppID" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6" />
                <TextBox x:Name="AppIdTextBox" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Descripción" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6" />
                <TextBox x:Name="DescriptionTextBox" />
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="5" Text="Plataformas y DepotIDs" Foreground="{StaticResource TextMuted}" Margin="0,18,0,8" />
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <CheckBox x:Name="WindowsCheckBox" Content="Windows" VerticalAlignment="Center" />
            <TextBox x:Name="WindowsDepotIdTextBox" Grid.Column="1" ToolTip="DepotID de Windows" />
            <CheckBox x:Name="LinuxCheckBox" Grid.Column="2" Content="Linux" VerticalAlignment="Center" />
            <TextBox x:Name="LinuxDepotIdTextBox" Grid.Column="3" ToolTip="DepotID de Linux" />
        </Grid>
        <Grid Grid.Row="7" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <CheckBox x:Name="MacosCheckBox" Content="macOS" VerticalAlignment="Center" />
            <TextBox x:Name="MacosDepotIdTextBox" Grid.Column="1" ToolTip="DepotID de macOS" />
        </Grid>

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Cancelar" Click="CancelButton_Click" Margin="0,0,10,0" />
            <Button Content="Agregar proyecto" Background="{StaticResource AccentBlue}" BorderBrush="#5BB8FF" Click="AddButton_Click" />
        </StackPanel>
    </Grid>
</Window>
